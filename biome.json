{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "tab"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnknownPseudoElement": "off"
      },
      "style": {
        "useImportType": "off"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/*.html",
      "!src/assets/**"
    ]
  }
}
