#!/usr/bin/env bash
# Post-merge hook: on develop and main, rebuild projects, changelog and posts after a merge, then commit the result.

set -e

branch=$(git rev-parse --abbrev-ref HEAD)
case "$branch" in
  main|develop) ;;
  *) exit 0 ;;
esac

echo "📚 Rebuilding projects, changelog and posts for $branch..."
bun run generate

git add src/assets/projects src/assets/project-dates.json src/assets/changelog src/assets/changelog.json src/assets/posts.json src/assets/generated.json
if ! git diff --cached --quiet; then
  git commit -m "docs: rebuild projects, changelog and posts" --no-verify
fi

echo "✅ Rebuilt"
