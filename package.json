{
  "name": "tertiumnon-github-io",
  "version": "2.0.3",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "gh:pages:build": "bun ./scripts/gh-pages/gh-pages--build/gh-pages--build.ts",
    "changelog:create": "bun ./scripts/changelog/changelog--create/changelog--create.ts",
    "project:create": "bun run project:github:create && bun run project:dates:create",
    "prepare": "git config core.hooksPath .githooks",
    "project:github:create": "bun ./scripts/project/github-projects--create/github-projects--create.ts",
    "post:create": "bun ./scripts/post/create/create.ts",
    "post:list:create": "bun ./scripts/post/list--create/list--create.ts",
    "generate": "bun run project:create && bun run changelog:create && bun run post:list:create && bun ./scripts/generate/stamp.ts",
    "project:dates:create": "bun ./scripts/project/dates--create/dates--create.ts",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint:fix": "bunx rome format --write src && bunx rome check src --apply",
    "typecheck": "tsc --noEmit",
    "release": "bun ./scripts/release/prepare.ts && bun node_modules/@tertium/js/scripts/release/release.ts",
    "release:patch": "bun run release patch",
    "release:minor": "bun run release minor",
    "release:major": "bun run release major"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@tertium/css": "1.5.1",
    "@tertium/js": "^3.2.0",
    "highlight.js": "^11.11.1",
    "jsdom": "^29.1.1",
    "marked": "^5.1.2",
    "rxjs": "^7.8.2",
    "sucrase": "^3.35.1",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2202.0",
    "@angular-devkit/core": "^22.2.0",
    "@angular-devkit/schematics": "^22.2.0",
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@types/bun": "^1.4.3",
    "@types/node": "^18.19.130",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.21",
    "rome": "^12.1.3",
    "typescript": "^6.0.0",
    "vitest": "^3.2.4"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ],
  "overrides": {
    "tar": "^7.5.20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tertiumnon/tertiumnon.github.io.git"
  }
}
